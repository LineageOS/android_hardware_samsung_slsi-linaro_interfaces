cc_binary {
    name: "vendor.samsung_slsi.hardware.SbwcDecompService-service",
    init_rc: ["vendor.samsung_slsi.hardware.SbwcDecompService-service.rc",],
    vintf_fragments: ["vendor.samsung_slsi.hardware.SbwcDecompService-service.xml"],
    relative_install_path: "hw",
    proprietary: true,
    srcs: [
        "SbwcDecompService.cpp",
        "service.cpp",
    ],
    shared_libs: [
        "libutils",
        "libcutils",
        "libbinder_ndk",
        "liblog",
        "libbase",
        "libui",
        "libion",
        "libexynosgraphicbuffer",
        "android.hardware.common-V2-ndk",
        "vendor.samsung_slsi.hardware.SbwcDecompService-V1-ndk",
        "libsbwcwrapper",
    ],
    static_libs: [
        "libaidlcommonsupport",
        "libsbwc",
    ],
    header_libs: ["libexynos_headers"],
}
